# Plantilla de secretos de Doctor J/K.
# Copiar a /etc/doctorjk/.env (permisos 600) y completar con credenciales reales.
# Nunca commitear el archivo .env real — está en .gitignore.

# Cliente LLM OpenAI-compatible (ver CONTEXTO-IA.md §5.5).
# Cambiar de proveedor (Cloudflare, DeepSeek, etc.) es cambiar estas 3 variables.
DOCTORJK_LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/{ACCOUNT_ID}/ai/v1
DOCTORJK_LLM_MODEL=@cf/openai/gpt-oss-120b
DOCTORJK_LLM_API_KEY=
