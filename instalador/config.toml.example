# Configuración de Doctor J/K. install.sh copia este archivo a
# /etc/doctorjk/config.toml solo si no existe ya uno (nunca pisa una
# instalación existente). Los secretos (token del proveedor LLM) NO van acá:
# viven en /etc/doctorjk/.env, ver .env.example en la raíz del repo.

# Segundos entre ciclos de muestreo del monitor.
intervalo_monitor_s = 30

# Cuántas muestras consecutivas cruzadas confirman un incidente. Evita que un
# pico de un solo ciclo dispare una falsa alarma. El mismo número de muestras
# consecutivas sanas resuelve el incidente.
ciclos_persistencia = 2

# Ciclos consecutivos sanos que debe esperar un incidente ya resuelto antes de
# volver a "normal" (ventana anti-parpadeo tras la recuperación).
enfriamiento_ciclos = 2

# Porcentaje de uso de disco a partir del cual se considera "disco lleno".
disco_pct = 90

# Memoria disponible mínima, en MB, antes de considerar "memoria baja".
memoria_disponible_mb = 512

# Segundos de espera al verificar si un puerto vigilado sigue escuchando.
puerto_timeout_s = 60

# Ciclos consecutivos con un servicio fallido antes de confirmar el incidente.
servicio_ciclos = 2

# Unidades systemd que el agente vigila explícitamente. Sin esta lista no hay
# forma de distinguir "el servicio está sano" de "nunca se consultó": ajustar
# a los servicios reales del cliente.
servicios_vigilados = ["nginx.service", "postgresql.service"]

# Puertos vigilados y el servicio que se espera que los tenga abiertos. Si el
# puerto está ocupado por otro proceso mientras el servicio esperado no está
# activo, se distingue de "nadie escucha" (port_down vs. port_occupied).
puertos_vigilados = [
  { puerto = 80, servicio = "nginx.service" },
  { puerto = 5432, servicio = "postgresql.service" },
]

# Única unidad que el Modo 2 puede reiniciar para liberar memoria (script
# fix_memoria.sh). Vacío ("") por defecto: sin una unidad aprobada
# explícitamente, el script escala en vez de matar procesos arbitrarios.
# Ajustar solo a un servicio propio del cliente cuyo consumo de memoria sea
# seguro de interrumpir con un restart.
unidad_memoria_aprobada = ""

# Directorio donde quedan los informes .md y su evidencia cruda asociada.
directorio_informes = "/var/lib/doctorjk/informes"

# Modo de remediación: "diagnostico" (solo redacta), "scripts" (Modo 2,
# ejecuta correcciones deterministas) o "automatico" (Modo 3, plan generado
# por el modelo). Una instalación nueva siempre queda en "diagnostico".
modo_remediacion = "diagnostico"

# Opt-in explícito para que el agente ejecute correcciones de verdad (tarea
# #210). Sin esto en true (o sin pasar --auto-fix), nunca se ejecuta nada,
# sin importar modo_remediacion.
auto_fix = false

# Si es true, el agente genera y valida el plan de corrección pero no lo
# ejecuta: útil para confiar en el modelo antes de habilitar auto_fix.
dry_run = true

# Timeout en segundos para cualquier comando externo que el agente ejecute.
timeout_comando_s = 30

# --- Modelo de diagnóstico -------------------------------------------------
# Cloudflare Workers AI y DeepSeek hablan el mismo formato OpenAI-compatible:
# cambiar de proveedor es cambiar estas dos líneas, no el código.
llm_url = "https://api.cloudflare.com/client/v4/accounts/TU_CUENTA/ai/v1/chat/completions"
# Identificador fijado por CONTEXTO-IA.md §4: Cloudflare Workers AI expone
# gpt-oss-120b bajo este namespace, no como "gpt-oss-120b" a secas.
llm_modelo = "@cf/openai/gpt-oss-120b"
# 30s se quedaba corto y probocaba caídas a fallback: gpt-oss-120b es un
# modelo de razonamiento y con evidencia real (journal de un incidente real)
# tardó más de 30s varias veces en una prueba contra Cloudflare real
# (plan-finalizacion-mvp.md Gate 3.2). Verificado: una respuesta completa con
# ese tamaño de evidencia tomó ~14-30s cuando salió bien.
llm_timeout_s = 60

# Solo desarrollo: reutiliza respuestas anteriores en vez de llamar al proveedor.
# Nunca activar en producción.
llm_cache = false

# La credencial NO va aquí. Se pasa por la variable de entorno
# DOCTORJK_LLM_API_KEY, porque este archivo lo edita el cliente y puede
# terminar en un backup o en un repositorio.
